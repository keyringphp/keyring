        "keyring.devices.index": "GET /user/devices",
        "keyring.devices.report": "GET /devices/{device}/report",
        "keyring.devices.report.store": "POST /devices/{device}/report",
        "keyring.email.confirm": "GET /email-changes/{change}/confirm/{token}",
        "keyring.email.confirm.store": "POST /email-changes/{change}/confirm",
        "keyring.email.destroy": "DELETE /user/email",
        "keyring.email.revert": "GET /email-changes/{change}/revert/{token}",
        "keyring.email.revert.store": "POST /email-changes/{change}/revert",
        "keyring.email.show": "GET /user/email",
        "keyring.email.store": "POST /user/email",
        "keyring.impersonation.destroy": "POST|DELETE /impersonate",
        "keyring.impersonation.store": "POST /impersonate/{user}",
        "keyring.login.challenge": "GET /login/challenge/{factor?}",
        "keyring.login.factor": "POST /login/{factor}",
        "keyring.login.options": "GET /login/{factor}/options",
        "keyring.login.send": "POST /login/challenge/{factor}/send",
        "keyring.login.verify": "POST /login/challenge/{factor}",
        "keyring.sessions.destroy": "DELETE /user/sessions/{session}",
        "keyring.sessions.destroy-others": "DELETE /user/sessions",
        "keyring.sessions.index": "GET /user/sessions",
        "keyring.sso.callback": "GET /auth/{provider}/callback",
        "keyring.sso.confirm": "GET /confirm/sso/redirect",
        "keyring.sso.redirect": "GET /auth/{provider}/redirect",
        "login": "GET /login",
        "login.store": "POST /login",
        "logout": "POST /logout",
        "password.email": "POST /forgot-password",
        "password.request": "GET /forgot-password",
        "password.reset": "GET /reset-password/{token}",
        "password.update": "POST /reset-password",
        "register": "GET /register",
        "register.store": "POST /register",
        "user-password.update": "PUT /user/password",
        "verification.notice": "GET /email/verify",
        "verification.send": "POST /email/verification-notification",
        "verification.verify": "GET /email/verify/{id}/{hash}",
        "verification.verify.store": "POST /email/verify/{id}/{hash}"
